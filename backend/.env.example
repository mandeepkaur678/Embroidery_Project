PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/embroidery_db

# JWT Configuration
JWT_SECRET=your_super_secret_access_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_change_in_production
JWT_ACCESS_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# Admin Seed Credentials (used by seedAdmin.js and scripts/createAdmin.js)
ADMIN_NAME=Artful Stitches Admin
ADMIN_EMAIL=admin@artfulstitches.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword

# Email Configuration (optional)
EMAIL_PASSWORD=your_email_app_password_here
